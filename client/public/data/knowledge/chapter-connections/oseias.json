    {
      "id": "person:jaco",
      "kind": "person",
      "label": "Jacó",
      "aliases": ["Jacó", "Israel"],
      "summary": "Jacó (do hebraico יַעֲקֹב, *Ya‘ăqōb*, cuja etimologia popular em Gênesis remete a \"aquele que suplanta\", \"enganador\" ou que segura o calcanhar) é o patriarca cujos doze filhos dão origem às doze tribos de Israel. Sua trajetória é uma das mais dinâmicas e psicológicas do Gênesis: começa como um homem astuto que obtém a primogenitura de Esaú por um prato de lentilhas e rouba a bênção paterna com o auxílio da mãe. Foge para Harã, onde trabalha por vinte anos para Labão, sendo por sua vez enganado no casamento com Lia e Raquel. Após acumular grande riqueza e rebanhos, empreende o retorno a Canaã. O ponto de virada espiritual de sua vida ocorre na travessia do rio Jaboque, onde luta misticamente a noite toda com um misterioso oponente (identificado como Deus ou o Anjo do Senhor), tendo seu nome mudado para **Israel** (\"aquele que luta com Deus\") após ferir-se na coxa [71].",
      "references": [
        "Gênesis 27:18–29",
        "Gênesis 28:10–22",
        "Gênesis 32:22–32",
        "Gênesis 49:1–33",
        "Oseias 12:3–4; Romanos 9:10–13",
        "Gn 25:29–34",
        "Gn 27",
        "Gn 28",
        "Gn 29–31",
        "Gn 32:22–32",
        "Gn 35",
        "Gn 46–49",
        "Os 12",
        "Mt 1:2"
      ],
      "sourceCatalogs": ["biography-catalog", "genesis-relational"],
      "maturity": "reviewed",
      "sourceIds": ["person-jaco", "jacob"],
      "attributes": {
        "periods": ["História bíblica"],
        "primarySource": "https://www.biblegateway.com/passage/?search=G%C3%AAnesis%2027%3A18%E2%80%9329%3B%20G%C3%AAnesis%2028%3A10%E2%80%9322%3B%20G%C3%AAnesis%2032%3A22%E2%80%9332&version=ARA",
        "bookLinksVerified": true,
        "role": "patriarca; ancestral epônimo de Israel",
        "tags": ["Israel", "bênção", "luta", "família"]
      }
    },
