    {
      "id": "term:emet",
      "kind": "term",
      "label": "Emet",
      "aliases": ["אֱמֶת", "ʾemet"],
      "summary": "Verdade, firmeza, confiabilidade e fidelidade; não apenas correspondência abstrata entre frase e realidade.",
      "references": ["Gn 24:27", "Êx 34:6", "Sl 119:160"],
      "sourceCatalogs": ["advanced-glossary"],
      "maturity": "reviewed",
      "sourceIds": ["emet"],
      "attributes": {
        "language": "Hebraico",
        "semanticRange": "Em narrativas e salmos pode caracterizar uma pessoa, uma promessa, um testemunho ou a estabilidade da ação de Deus.",
        "translationNote": "‘Verdade’ é adequada em muitos contextos, mas ‘fidelidade’ pode ser mais precisa quando o foco está no caráter confiável de uma relação."
      }
    },
    {
      "id": "term:hesed",
      "kind": "term",
      "label": "Hesed",
      "aliases": ["חֶסֶד", "ḥesed"],
      "summary": "Vocabulário de lealdade relacional, bondade comprometida e ação favorável que sustenta uma relação.",
      "references": ["Êx 34:6", "Rt 1:8", "Sl 136:1", "Os 6:6"],
      "sourceCatalogs": ["advanced-glossary"],
      "maturity": "reviewed",
      "sourceIds": ["hesed"],
      "attributes": {
        "language": "Hebraico",
        "semanticRange": "Dependendo do contexto pode apontar para misericórdia, lealdade, benevolência, fidelidade ou amor constante. Nenhum equivalente isolado resolve todos os usos.",
        "translationNote": "Traduzir sempre por ‘misericórdia’ ou sempre por ‘amor’ pode esconder a dimensão de compromisso. A análise deve observar quem age, com quem, em qual relação e com qual consequência narrativa."
      }
    },
    {
      "id": "term:mishpat",
      "kind": "term",
      "label": "Mishpat",
      "aliases": ["מִשְׁפָּט", "mišpāṭ"],
      "summary": "Juízo, decisão, direito ou ordem justa que regula relações e protege a vida comunitária.",
      "references": ["Êx 21:1", "Am 5:24", "Mq 6:8"],
      "sourceCatalogs": ["advanced-glossary"],
      "maturity": "reviewed",
      "sourceIds": ["mishpat"],
      "attributes": {
        "language": "Hebraico",
        "semanticRange": "Pode designar um caso decidido, uma norma, a administração da justiça ou o juízo de Deus sobre uma sociedade.",
        "translationNote": "‘Justiça’ e ‘juízo’ cobrem partes do campo semântico; o leitor deve perguntar se o texto trata de tribunal, ordem social ou ação divina."
      }
    },
    {
      "id": "term:qadosh",
      "kind": "term",
      "label": "Qadosh",
      "aliases": ["קָדוֹשׁ", "qādôš"],
      "summary": "Separado, distinto, consagrado ou pertencente a uma esfera de santidade; a ideia de separação não elimina a dimensão ética.",
      "references": ["Êx 19:5–6", "Lv 19:1–18", "Is 6:1–8"],
      "sourceCatalogs": ["advanced-glossary"],
      "maturity": "reviewed",
      "sourceIds": ["qadosh"],
      "attributes": {
        "language": "Hebraico",
        "semanticRange": "O termo percorre a distinção cultual, a alteridade divina e a convocação de uma comunidade a refletir a justiça de Deus.",
        "translationNote": "‘Santo’ preserva a tradição, mas a interpretação precisa mostrar como o texto transforma santidade em prática comunitária, não apenas em distância ritual."
      }
    },
